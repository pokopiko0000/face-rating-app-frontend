# Face Rating App Backend Environment Variables
# Copy this file to .env and update the values according to your environment

# Application Environment (development, staging, production)
FACE_RATING_ENVIRONMENT=development

# Debug mode (true/false)
FACE_RATING_DEBUG=true

# Server Configuration
FACE_RATING_HOST=0.0.0.0
FACE_RATING_PORT=8003

# External Services
FACE_RATING_R2_PUBLIC_URL=https://pub-20801d1056e542a99ab766366e3a3124.r2.dev
FACE_RATING_GCS_BUCKET_NAME=imagen4-faces-imagen-demo-460715

# CORS Configuration (comma-separated list)
FACE_RATING_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
FACE_RATING_CORS_ALLOW_CREDENTIALS=true

# Face Analysis Settings
FACE_RATING_GEO_BONUS=0.05
FACE_RATING_RARITY_BONUS_UNIT=0.01
FACE_RATING_DET_THRESH=0.1
FACE_RATING_CONFIDENCE_THRESHOLD=0.25

# Model Settings
FACE_RATING_FACE_ANALYSIS_PROVIDERS=CPUExecutionProvider